<ui:InvokeCode ContinueOnError="{x:Null}" Code="' Unexpected error on one case: count it, log it, save a screenshot, move the files to _failed and keep going.&#xA;failedCount = failedCount + 1&#xA;Dim stamp As String = DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;)&#xA;Dim fileStamp As String = DateTime.Now.ToString(&quot;yyyyMMdd_HHmmss_fff&quot;)&#xA;LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; stamp &amp; &quot;] ERROR case &quot; &amp; caseKey &amp; &quot;: &quot; &amp; caughtEx.Message &amp; Environment.NewLine&#xA;&#xA;Dim names As New System.Collections.Generic.List(Of String)()&#xA;If caseFiles IsNot Nothing Then&#xA;    For Each f As String In caseFiles&#xA;        names.Add(System.IO.Path.GetFileName(f))&#xA;        Try&#xA;            If System.IO.File.Exists(f) Then&#xA;                System.IO.File.Move(f, System.IO.Path.Combine(FailedDir, fileStamp &amp; &quot;_&quot; &amp; System.IO.Path.GetFileName(f)))&#xA;            End If&#xA;        Catch mvEx As Exception&#xA;        End Try&#xA;    Next&#xA;End If&#xA;&#xA;Try&#xA;    System.IO.File.WriteAllText(System.IO.Path.Combine(FailedDir, &quot;error_&quot; &amp; fileStamp &amp; &quot;.txt&quot;),&#xA;        &quot;Case: &quot; &amp; caseKey &amp; Environment.NewLine &amp; &quot;Files: &quot; &amp; String.Join(&quot;; &quot;, names) &amp; Environment.NewLine &amp;&#xA;        &quot;Error: &quot; &amp; caughtEx.Message &amp; Environment.NewLine &amp; &quot;Stack: &quot; &amp; caughtEx.StackTrace)&#xA;    Dim bounds As System.Drawing.Rectangle = System.Windows.Forms.Screen.PrimaryScreen.Bounds&#xA;    Using bmp As New System.Drawing.Bitmap(bounds.Width, bounds.Height)&#xA;        Using g As System.Drawing.Graphics = System.Drawing.Graphics.FromImage(bmp)&#xA;            g.CopyFromScreen(System.Drawing.Point.Empty, System.Drawing.Point.Empty, bounds.Size)&#xA;        End Using&#xA;        bmp.Save(System.IO.Path.Combine(FailedDir, &quot;error_&quot; &amp; fileStamp &amp; &quot;.png&quot;), System.Drawing.Imaging.ImageFormat.Png)&#xA;    End Using&#xA;Catch shotEx As Exception&#xA;    LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; stamp &amp; &quot;]   (screenshot not saved: &quot; &amp; shotEx.Message &amp; &quot;)&quot; &amp; Environment.NewLine&#xA;End Try&#xA;&#xA;Dim msgText As String = caughtEx.Message.Replace(&quot;&quot;&quot;&quot;, &quot;'&quot;).Replace(vbCr, &quot; &quot;).Replace(vbLf, &quot; &quot;)&#xA;ReportRows = ReportRows &amp; &quot;&quot;&quot;&quot; &amp; RunId &amp; &quot;&quot;&quot;,&quot;&quot;&quot; &amp; stamp &amp; &quot;&quot;&quot;,&quot;&quot;&quot; &amp; If(caseKey, &quot;&quot;) &amp; &quot;&quot;&quot;,&quot;&quot;&quot; &amp; String.Join(&quot;; &quot;, names).Replace(&quot;&quot;&quot;&quot;, &quot;'&quot;) &amp; &quot;&quot;&quot;,,,,,,,,,,,&quot;&quot;Error&quot;&quot;,&quot;&quot;&quot; &amp; msgText &amp; &quot;&quot;&quot;&quot; &amp; Environment.NewLine&#xA;" DisplayName="Screenshot + log + move to _failed" sap2010:WorkflowViewState.IdRef="InvokeCode_32">
