<ui:InvokeCode ContinueOnError="{x:Null}" Code="' Read every file of this case: text files and .docx are extracted to text, images and PDFs are queued for&#xA;' the OpenAI vision/file input. Also computes a SHA-256 over the case content for duplicate protection.&#xA;Dim firstName As String = System.IO.Path.GetFileName(caseFiles(0))&#xA;Dim sepPos As Integer = firstName.IndexOf(&quot;__&quot;)&#xA;If sepPos &gt; 0 Then&#xA;    caseKey = firstName.Substring(0, sepPos)&#xA;Else&#xA;    caseKey = System.IO.Path.GetFileNameWithoutExtension(firstName)&#xA;End If&#xA;&#xA;Dim textExt As String() = New String() {&quot;.txt&quot;, &quot;.md&quot;, &quot;.csv&quot;, &quot;.json&quot;, &quot;.log&quot;, &quot;.xml&quot;, &quot;.eml&quot;, &quot;.html&quot;, &quot;.htm&quot;}&#xA;Dim imgExt As String() = New String() {&quot;.jpg&quot;, &quot;.jpeg&quot;, &quot;.png&quot;, &quot;.webp&quot;, &quot;.gif&quot;}&#xA;&#xA;Dim sb As New System.Text.StringBuilder()&#xA;Dim imgs As New System.Collections.Generic.List(Of String)()&#xA;Dim pdfs As New System.Collections.Generic.List(Of String)()&#xA;Dim srcArr As New Newtonsoft.Json.Linq.JArray()&#xA;Dim allBytes As New System.IO.MemoryStream()&#xA;&#xA;For Each f As String In caseFiles&#xA;    Dim ext As String = System.IO.Path.GetExtension(f).ToLowerInvariant()&#xA;    Dim fname As String = System.IO.Path.GetFileName(f)&#xA;    Dim fileBytes As Byte() = System.IO.File.ReadAllBytes(f)&#xA;    allBytes.Write(fileBytes, 0, fileBytes.Length)&#xA;&#xA;    Dim fileText As String = &quot;&quot;&#xA;    Dim kind As String = &quot;text&quot;&#xA;&#xA;    If Array.IndexOf(textExt, ext) &gt;= 0 Then&#xA;        fileText = System.Text.Encoding.UTF8.GetString(fileBytes).TrimStart(ChrW(&amp;HFEFF))&#xA;        If ext = &quot;.html&quot; OrElse ext = &quot;.htm&quot; Then&#xA;            fileText = System.Text.RegularExpressions.Regex.Replace(fileText, &quot;&lt;(br|/p|/div|/tr|/li)[^&gt;]*&gt;&quot;, Environment.NewLine, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;            fileText = System.Text.RegularExpressions.Regex.Replace(fileText, &quot;&lt;[^&gt;]+&gt;&quot;, &quot; &quot;)&#xA;            fileText = System.Web.HttpUtility.HtmlDecode(fileText)&#xA;        End If&#xA;    ElseIf ext = &quot;.docx&quot; Then&#xA;        kind = &quot;document&quot;&#xA;        Try&#xA;            Using ms As New System.IO.MemoryStream(fileBytes)&#xA;                Using zip As New System.IO.Compression.ZipArchive(ms, System.IO.Compression.ZipArchiveMode.Read)&#xA;                    Dim entry As System.IO.Compression.ZipArchiveEntry = zip.GetEntry(&quot;word/document.xml&quot;)&#xA;                    If entry IsNot Nothing Then&#xA;                        Using rdr As New System.IO.StreamReader(entry.Open())&#xA;                            Dim xml As String = rdr.ReadToEnd()&#xA;                            xml = xml.Replace(&quot;&lt;/w:p&gt;&quot;, vbLf).Replace(&quot;&lt;w:tab/&gt;&quot;, vbTab).Replace(&quot;&lt;w:br/&gt;&quot;, vbLf)&#xA;                            xml = System.Text.RegularExpressions.Regex.Replace(xml, &quot;&lt;[^&gt;]+&gt;&quot;, &quot;&quot;)&#xA;                            fileText = System.Web.HttpUtility.HtmlDecode(xml)&#xA;                        End Using&#xA;                    End If&#xA;                End Using&#xA;            End Using&#xA;        Catch docxEx As Exception&#xA;            fileText = &quot;&quot;&#xA;        End Try&#xA;    ElseIf ext = &quot;.pdf&quot; Then&#xA;        kind = &quot;pdf&quot;&#xA;        pdfs.Add(f)&#xA;    ElseIf Array.IndexOf(imgExt, ext) &gt;= 0 Then&#xA;        kind = &quot;image&quot;&#xA;        imgs.Add(f)&#xA;    Else&#xA;        kind = &quot;unsupported&quot;&#xA;    End If&#xA;&#xA;    If fileText.Trim().Length &gt; 0 Then&#xA;        sb.AppendLine(&quot;===== FILE: &quot; &amp; fname &amp; &quot; =====&quot;)&#xA;        sb.AppendLine(fileText.Trim())&#xA;        sb.AppendLine()&#xA;    End If&#xA;&#xA;    ' Channel guess: file name first, then the start of the text&#xA;    Dim lowerName As String = fname.ToLowerInvariant()&#xA;    Dim head As String = fileText&#xA;    If head.Length &gt; 400 Then&#xA;        head = head.Substring(0, 400)&#xA;    End If&#xA;    head = head.ToLowerInvariant()&#xA;    Dim ch As String = &quot;Upload&quot;&#xA;    If kind = &quot;image&quot; Then&#xA;        ch = &quot;Image&quot;&#xA;    ElseIf lowerName.Contains(&quot;whatsapp&quot;) Then&#xA;        ch = &quot;WhatsApp&quot;&#xA;    ElseIf lowerName.Contains(&quot;teams&quot;) Then&#xA;        ch = &quot;Teams&quot;&#xA;    ElseIf lowerName.Contains(&quot;call&quot;) Then&#xA;        ch = &quot;Call Note&quot;&#xA;    ElseIf lowerName.Contains(&quot;handwritten&quot;) OrElse lowerName.Contains(&quot;warehouse&quot;) Then&#xA;        ch = &quot;Handwritten Note&quot;&#xA;    ElseIf lowerName.StartsWith(&quot;email-&quot;) OrElse lowerName.Contains(&quot;email&quot;) OrElse ext = &quot;.eml&quot; Then&#xA;        ch = &quot;Email&quot;&#xA;    ElseIf head.Contains(&quot;email&quot;) OrElse head.Contains(&quot;subject:&quot;) Then&#xA;        ch = &quot;Email&quot;&#xA;    ElseIf head.Contains(&quot;whatsapp&quot;) Then&#xA;        ch = &quot;WhatsApp&quot;&#xA;    ElseIf head.Contains(&quot;teams&quot;) Then&#xA;        ch = &quot;Teams&quot;&#xA;    ElseIf head.Contains(&quot;call note&quot;) OrElse head.Contains(&quot;call center&quot;) OrElse head.Contains(&quot;call centre&quot;) Then&#xA;        ch = &quot;Call Note&quot;&#xA;    ElseIf head.Contains(&quot;handwritten&quot;) Then&#xA;        ch = &quot;Handwritten Note&quot;&#xA;    ElseIf kind = &quot;pdf&quot; OrElse kind = &quot;document&quot; Then&#xA;        ch = &quot;Document&quot;&#xA;    End If&#xA;&#xA;    Dim src As New Newtonsoft.Json.Linq.JObject()&#xA;    src.Add(&quot;file&quot;, New Newtonsoft.Json.Linq.JValue(fname))&#xA;    src.Add(&quot;kind&quot;, New Newtonsoft.Json.Linq.JValue(kind))&#xA;    src.Add(&quot;channel&quot;, New Newtonsoft.Json.Linq.JValue(ch))&#xA;    src.Add(&quot;text&quot;, New Newtonsoft.Json.Linq.JValue(fileText.Trim()))&#xA;    src.Add(&quot;timestamp&quot;, New Newtonsoft.Json.Linq.JValue(System.IO.File.GetLastWriteTimeUtc(f).ToString(&quot;o&quot;)))&#xA;    srcArr.Add(src)&#xA;Next&#xA;&#xA;rawText = sb.ToString()&#xA;imageFiles = imgs.ToArray()&#xA;pdfFiles = pdfs.ToArray()&#xA;sourcesJson = srcArr.ToString(Newtonsoft.Json.Formatting.None)&#xA;&#xA;' SHA-256 of the combined content (names are ignored because fetch timestamps change them)&#xA;Using sha As System.Security.Cryptography.SHA256 = System.Security.Cryptography.SHA256.Create()&#xA;    caseHash = BitConverter.ToString(sha.ComputeHash(allBytes.ToArray())).Replace(&quot;-&quot;, &quot;&quot;).ToLowerInvariant()&#xA;End Using&#xA;&#xA;isDuplicate = False&#xA;If System.IO.File.Exists(HashLogFile) Then&#xA;    Dim cutoff As DateTime = DateTime.UtcNow.AddDays(-DedupWindowDays)&#xA;    For Each line As String In System.IO.File.ReadAllLines(HashLogFile)&#xA;        Dim parts As String() = line.Split(&quot;,&quot;c)&#xA;        If parts.Length &gt;= 2 AndAlso parts(0).Trim() = caseHash Then&#xA;            Dim seenAt As DateTime&#xA;            If DateTime.TryParse(parts(1), System.Globalization.CultureInfo.InvariantCulture, System.Globalization.DateTimeStyles.RoundtripKind, seenAt) Then&#xA;                If seenAt.ToUniversalTime() &gt;= cutoff Then&#xA;                    isDuplicate = True&#xA;                    Exit For&#xA;                End If&#xA;            End If&#xA;        End If&#xA;    Next&#xA;End If&#xA;" DisplayName="5a. Read files + extract text + SHA-256 dedup check" sap2010:WorkflowViewState.IdRef="InvokeCode_13">
