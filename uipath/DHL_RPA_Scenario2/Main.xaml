<ui:InvokeCode ContinueOnError="{x:Null}" Code="' Exchange the Google refresh token for a short-lived access token.&#xA;GoogleAccessToken = &quot;&quot;&#xA;If String.IsNullOrWhiteSpace(GoogleClientId) OrElse String.IsNullOrWhiteSpace(GoogleClientSecret) OrElse String.IsNullOrWhiteSpace(GoogleRefreshToken) Then&#xA;    LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] Drive: skipped - Google client id / secret / refresh token not set&quot; &amp; Environment.NewLine&#xA;Else&#xA;    Try&#xA;        Using http As New System.Net.Http.HttpClient()&#xA;            http.Timeout = TimeSpan.FromSeconds(30)&#xA;            Dim parameters As New System.Collections.Generic.Dictionary(Of String, String)()&#xA;            parameters.Add(&quot;client_id&quot;, GoogleClientId)&#xA;            parameters.Add(&quot;client_secret&quot;, GoogleClientSecret)&#xA;            parameters.Add(&quot;refresh_token&quot;, GoogleRefreshToken)&#xA;            parameters.Add(&quot;grant_type&quot;, &quot;refresh_token&quot;)&#xA;            Using form As New System.Net.Http.FormUrlEncodedContent(parameters)&#xA;                Dim resp As System.Net.Http.HttpResponseMessage = http.PostAsync(&quot;https://oauth2.googleapis.com/token&quot;, form).Result&#xA;                Dim respBody As String = resp.Content.ReadAsStringAsync().Result&#xA;                If resp.IsSuccessStatusCode Then&#xA;                    Dim parsed As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(respBody)&#xA;                    GoogleAccessToken = parsed.Value(Of String)(&quot;access_token&quot;)&#xA;                    LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] Drive: OAuth token refreshed&quot; &amp; Environment.NewLine&#xA;                Else&#xA;                    LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] Drive: OAuth refresh FAILED HTTP &quot; &amp; CInt(resp.StatusCode).ToString() &amp; &quot; - &quot; &amp; respBody &amp; Environment.NewLine&#xA;                End If&#xA;            End Using&#xA;        End Using&#xA;    Catch ex As Exception&#xA;        GoogleAccessToken = &quot;&quot;&#xA;        LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] Drive: OAuth exception - &quot; &amp; ex.Message &amp; Environment.NewLine&#xA;    End Try&#xA;End If&#xA;If GoogleAccessToken Is Nothing Then&#xA;    GoogleAccessToken = &quot;&quot;&#xA;End If&#xA;" DisplayName="Refresh Google OAuth token" sap2010:WorkflowViewState.IdRef="InvokeCode_7">
