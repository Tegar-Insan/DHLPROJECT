<ui:InvokeCode ContinueOnError="{x:Null}" Code="' Reporting (errors + summary): run log and a CSV report per run in &lt;InboxRoot&gt;\_reports.&#xA;Dim finished As DateTime = DateTime.Now&#xA;Dim sb As New System.Text.StringBuilder()&#xA;sb.AppendLine(&quot;DHL Incident RPA - Run Summary (Scenario 2)&quot;)&#xA;sb.AppendLine(&quot;===========================================&quot;)&#xA;sb.AppendLine(&quot;Run ID:        &quot; &amp; RunId)&#xA;sb.AppendLine(&quot;Started:       &quot; &amp; RunStartTime.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;))&#xA;sb.AppendLine(&quot;Finished:      &quot; &amp; finished.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;))&#xA;sb.AppendLine(&quot;Duration:      &quot; &amp; (finished - RunStartTime).TotalSeconds.ToString(&quot;0.0&quot;) &amp; &quot; s&quot;)&#xA;sb.AppendLine(&quot;&quot;)&#xA;sb.AppendLine(&quot;Fetched&quot;)&#xA;sb.AppendLine(&quot;-------&quot;)&#xA;sb.AppendLine(&quot;Gmail emails:  &quot; &amp; gmailFetchedCount.ToString())&#xA;sb.AppendLine(&quot;Drive files:   &quot; &amp; driveFetchedCount.ToString())&#xA;sb.AppendLine(&quot;&quot;)&#xA;sb.AppendLine(&quot;Results&quot;)&#xA;sb.AppendLine(&quot;-------&quot;)&#xA;sb.AppendLine(&quot;Cases found:   &quot; &amp; caseCount.ToString())&#xA;sb.AppendLine(&quot;Created:       &quot; &amp; createdCount.ToString())&#xA;sb.AppendLine(&quot;Merged:        &quot; &amp; mergedCount.ToString())&#xA;sb.AppendLine(&quot;Duplicates:    &quot; &amp; duplicateCount.ToString())&#xA;sb.AppendLine(&quot;Failed:        &quot; &amp; failedCount.ToString())&#xA;sb.AppendLine(&quot;AI extracted:  &quot; &amp; aiSuccessCount.ToString())&#xA;sb.AppendLine(&quot;AI fallback:   &quot; &amp; aiFallbackCount.ToString())&#xA;sb.AppendLine(&quot;&quot;)&#xA;sb.AppendLine(&quot;Report CSV:    &quot; &amp; ReportCsvFile)&#xA;sb.AppendLine(&quot;&quot;)&#xA;sb.AppendLine(&quot;Detailed log&quot;)&#xA;sb.AppendLine(&quot;------------&quot;)&#xA;sb.Append(LogBuilderStr)&#xA;&#xA;RunSummaryText = sb.ToString()&#xA;System.IO.File.WriteAllText(RunLogFile, RunSummaryText, System.Text.Encoding.UTF8)&#xA;System.IO.File.WriteAllText(ReportCsvFile, ReportRows, New System.Text.UTF8Encoding(True))&#xA;" DisplayName="6. Reporting - write run log + CSV report" sap2010:WorkflowViewState.IdRef="InvokeCode_39">
