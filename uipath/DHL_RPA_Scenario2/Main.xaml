<ui:InvokeCode ContinueOnError="{x:Null}" Code="' Same content already posted within the dedup window: skip it, move to _processed\duplicates, report it.&#xA;duplicateCount = duplicateCount + 1&#xA;Dim stamp As String = DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;)&#xA;Dim dupDir As String = System.IO.Path.Combine(ProcessedDir, &quot;duplicates&quot;)&#xA;System.IO.Directory.CreateDirectory(dupDir)&#xA;Dim names As New System.Collections.Generic.List(Of String)()&#xA;For Each f As String In caseFiles&#xA;    names.Add(System.IO.Path.GetFileName(f))&#xA;    Try&#xA;        If System.IO.File.Exists(f) Then&#xA;            Dim dest As String = System.IO.Path.Combine(dupDir, DateTime.Now.ToString(&quot;yyyyMMddHHmmssfff&quot;) &amp; &quot;_&quot; &amp; System.IO.Path.GetFileName(f))&#xA;            System.IO.File.Move(f, dest)&#xA;        End If&#xA;    Catch mvEx As Exception&#xA;        LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; stamp &amp; &quot;] WARN could not move duplicate &quot; &amp; f &amp; &quot;: &quot; &amp; mvEx.Message &amp; Environment.NewLine&#xA;    End Try&#xA;Next&#xA;Dim joined As String = String.Join(&quot;; &quot;, names).Replace(&quot;&quot;&quot;&quot;, &quot;'&quot;)&#xA;ReportRows = ReportRows &amp; &quot;&quot;&quot;&quot; &amp; RunId &amp; &quot;&quot;&quot;,&quot;&quot;&quot; &amp; stamp &amp; &quot;&quot;&quot;,&quot;&quot;&quot; &amp; caseKey &amp; &quot;&quot;&quot;,&quot;&quot;&quot; &amp; joined &amp; &quot;&quot;&quot;,,,,,,,&quot;&quot;No&quot;&quot;,,,,&quot;&quot;Duplicate&quot;&quot;,&quot;&quot;Same content already imported within dedup window&quot;&quot;&quot; &amp; Environment.NewLine&#xA;LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; stamp &amp; &quot;] CASE &quot; &amp; caseKey &amp; &quot; -&gt; DUPLICATE skipped (hash &quot; &amp; caseHash.Substring(0, 10) &amp; &quot;...)&quot; &amp; Environment.NewLine&#xA;" DisplayName="Move duplicate + report row" sap2010:WorkflowViewState.IdRef="InvokeCode_14">
