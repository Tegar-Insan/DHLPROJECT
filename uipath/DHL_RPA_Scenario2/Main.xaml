<ui:InvokeCode ContinueOnError="{x:Null}" Code="' Read the backend reply: incident code, merged-or-created, errors.&#xA;incidentCode = &quot;&quot;&#xA;mergedFlag = False&#xA;caseResult = &quot;Failed&quot;&#xA;caseError = &quot;&quot;&#xA;Try&#xA;    Dim resp As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(If(responseText, &quot;{}&quot;))&#xA;    Dim okTok As Newtonsoft.Json.Linq.JToken = resp(&quot;ok&quot;)&#xA;    Dim isOk As Boolean = okTok IsNot Nothing AndAlso okTok.Type = Newtonsoft.Json.Linq.JTokenType.Boolean AndAlso okTok.ToObject(Of Boolean)()&#xA;    If resp(&quot;incidentCode&quot;) IsNot Nothing Then&#xA;        incidentCode = resp(&quot;incidentCode&quot;).ToString()&#xA;    End If&#xA;    If resp(&quot;merged&quot;) IsNot Nothing AndAlso resp(&quot;merged&quot;).Type = Newtonsoft.Json.Linq.JTokenType.Boolean Then&#xA;        mergedFlag = resp(&quot;merged&quot;).ToObject(Of Boolean)()&#xA;    End If&#xA;    If isOk AndAlso httpStatus &gt;= 200 AndAlso httpStatus &lt; 300 Then&#xA;        If mergedFlag Then&#xA;            mergedCount = mergedCount + 1&#xA;            caseResult = &quot;Merged&quot;&#xA;        Else&#xA;            createdCount = createdCount + 1&#xA;            caseResult = &quot;Created&quot;&#xA;        End If&#xA;    Else&#xA;        Dim msgText As String = &quot;&quot;&#xA;        If resp(&quot;message&quot;) IsNot Nothing Then&#xA;            msgText = resp(&quot;message&quot;).ToString()&#xA;        ElseIf resp(&quot;errors&quot;) IsNot Nothing Then&#xA;            msgText = resp(&quot;errors&quot;).ToString(Newtonsoft.Json.Formatting.None)&#xA;        ElseIf resp(&quot;title&quot;) IsNot Nothing Then&#xA;            msgText = resp(&quot;title&quot;).ToString()&#xA;        End If&#xA;        caseError = &quot;HTTP &quot; &amp; httpStatus.ToString() &amp; &quot; &quot; &amp; msgText&#xA;    End If&#xA;Catch ex As Exception&#xA;    Dim shortResp As String = If(responseText, &quot;&quot;)&#xA;    If shortResp.Length &gt; 200 Then&#xA;        shortResp = shortResp.Substring(0, 200)&#xA;    End If&#xA;    caseError = &quot;HTTP &quot; &amp; httpStatus.ToString() &amp; &quot; unreadable response: &quot; &amp; shortResp&#xA;End Try&#xA;If caseError.Length &gt; 400 Then&#xA;    caseError = caseError.Substring(0, 400)&#xA;End If&#xA;" DisplayName="5e. Parse backend response" sap2010:WorkflowViewState.IdRef="InvokeCode_24">
