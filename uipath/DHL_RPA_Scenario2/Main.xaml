<ui:InvokeCode ContinueOnError="{x:Null}" Code="' Download new files from the Google Drive folder into the single Incoming folder,&#xA;' then rename them in Drive to &quot;[processed] ...&quot; so they are not fetched twice.&#xA;' Grouping tip: name Drive files &quot;&lt;CASE&gt;__&lt;anything&gt;&quot; (e.g. MY987623400__photo.jpg) to analyse them as one case.&#xA;Dim downloaded As Integer = 0&#xA;If String.IsNullOrEmpty(GoogleAccessToken) OrElse String.IsNullOrWhiteSpace(GoogleDriveFolderId) Then&#xA;    LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] Drive: download skipped (no token or folder id)&quot; &amp; Environment.NewLine&#xA;Else&#xA;    Try&#xA;        Using http As New System.Net.Http.HttpClient()&#xA;            http.Timeout = TimeSpan.FromSeconds(90)&#xA;            http.DefaultRequestHeaders.Authorization = New System.Net.Http.Headers.AuthenticationHeaderValue(&quot;Bearer&quot;, GoogleAccessToken)&#xA;&#xA;            Dim q As String = &quot;'&quot; &amp; GoogleDriveFolderId &amp; &quot;' in parents and trashed=false and not name contains '[processed]'&quot;&#xA;            Dim listUrl As String = &quot;https://www.googleapis.com/drive/v3/files?q=&quot; &amp; System.Uri.EscapeDataString(q) &amp; &quot;&amp;fields=files(id,name,mimeType)&amp;pageSize=100&quot;&#xA;            Dim listResp As System.Net.Http.HttpResponseMessage = http.GetAsync(listUrl).Result&#xA;            Dim listBody As String = listResp.Content.ReadAsStringAsync().Result&#xA;&#xA;            If Not listResp.IsSuccessStatusCode Then&#xA;                LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] Drive: list FAILED HTTP &quot; &amp; CInt(listResp.StatusCode).ToString() &amp; &quot; - &quot; &amp; listBody &amp; Environment.NewLine&#xA;            Else&#xA;                Dim parsedList As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(listBody)&#xA;                Dim driveFiles As Newtonsoft.Json.Linq.JArray = TryCast(parsedList(&quot;files&quot;), Newtonsoft.Json.Linq.JArray)&#xA;                If driveFiles IsNot Nothing Then&#xA;                    For Each tok As Newtonsoft.Json.Linq.JToken In driveFiles&#xA;                        Dim fileId As String = tok.Value(Of String)(&quot;id&quot;)&#xA;                        Dim fileName As String = tok.Value(Of String)(&quot;name&quot;)&#xA;                        Dim mimeType As String = tok.Value(Of String)(&quot;mimeType&quot;)&#xA;                        Try&#xA;                            Dim dlUrl As String&#xA;                            If mimeType = &quot;application/vnd.google-apps.document&quot; Then&#xA;                                dlUrl = &quot;https://www.googleapis.com/drive/v3/files/&quot; &amp; fileId &amp; &quot;/export?mimeType=text%2Fplain&quot;&#xA;                                fileName = fileName &amp; &quot;.txt&quot;&#xA;                            ElseIf mimeType.StartsWith(&quot;application/vnd.google-apps.&quot;) Then&#xA;                                LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] Drive: skipped Google-native file '&quot; &amp; fileName &amp; &quot;' (&quot; &amp; mimeType &amp; &quot;)&quot; &amp; Environment.NewLine&#xA;                                Continue For&#xA;                            Else&#xA;                                dlUrl = &quot;https://www.googleapis.com/drive/v3/files/&quot; &amp; fileId &amp; &quot;?alt=media&quot;&#xA;                            End If&#xA;&#xA;                            Dim dlResp As System.Net.Http.HttpResponseMessage = http.GetAsync(dlUrl).Result&#xA;                            If Not dlResp.IsSuccessStatusCode Then&#xA;                                LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] Drive: download FAILED '&quot; &amp; fileName &amp; &quot;' HTTP &quot; &amp; CInt(dlResp.StatusCode).ToString() &amp; Environment.NewLine&#xA;                                Continue For&#xA;                            End If&#xA;                            Dim fileBytes As Byte() = dlResp.Content.ReadAsByteArrayAsync().Result&#xA;&#xA;                            Dim safeName As String = fileName&#xA;                            For Each bad As Char In System.IO.Path.GetInvalidFileNameChars()&#xA;                                safeName = safeName.Replace(bad, &quot;_&quot;c)&#xA;                            Next&#xA;                            Dim ts As String = DateTime.Now.ToString(&quot;yyyyMMddHHmmssfff&quot;)&#xA;                            Dim saveName As String&#xA;                            Dim sep As Integer = safeName.IndexOf(&quot;__&quot;)&#xA;                            If sep &gt; 0 Then&#xA;                                saveName = safeName.Substring(0, sep) &amp; &quot;__&quot; &amp; ts &amp; &quot;_&quot; &amp; safeName.Substring(sep + 2)&#xA;                            Else&#xA;                                saveName = &quot;DRIVE-&quot; &amp; ts &amp; &quot;-&quot; &amp; (downloaded + 1).ToString(&quot;000&quot;) &amp; &quot;__&quot; &amp; safeName&#xA;                            End If&#xA;                            System.IO.File.WriteAllBytes(System.IO.Path.Combine(IncomingDir, saveName), fileBytes)&#xA;                            downloaded = downloaded + 1&#xA;                            LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] Drive: downloaded '&quot; &amp; fileName &amp; &quot;' (&quot; &amp; fileBytes.Length.ToString() &amp; &quot; bytes) as &quot; &amp; saveName &amp; Environment.NewLine&#xA;&#xA;                            Try&#xA;                                Dim renameObj As New Newtonsoft.Json.Linq.JObject()&#xA;                                renameObj.Add(&quot;name&quot;, New Newtonsoft.Json.Linq.JValue(&quot;[processed] &quot; &amp; tok.Value(Of String)(&quot;name&quot;)))&#xA;                                Using renameReq As New System.Net.Http.HttpRequestMessage(New System.Net.Http.HttpMethod(&quot;PATCH&quot;), &quot;https://www.googleapis.com/drive/v3/files/&quot; &amp; fileId)&#xA;                                    renameReq.Content = New System.Net.Http.StringContent(renameObj.ToString(Newtonsoft.Json.Formatting.None), System.Text.Encoding.UTF8, &quot;application/json&quot;)&#xA;                                    http.SendAsync(renameReq).Wait()&#xA;                                End Using&#xA;                            Catch renameEx As Exception&#xA;                                LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] Drive: rename failed for '&quot; &amp; fileName &amp; &quot;': &quot; &amp; renameEx.Message &amp; Environment.NewLine&#xA;                            End Try&#xA;                        Catch fileEx As Exception&#xA;                            LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] Drive: error on '&quot; &amp; fileName &amp; &quot;': &quot; &amp; fileEx.Message &amp; Environment.NewLine&#xA;                        End Try&#xA;                    Next&#xA;                End If&#xA;            End If&#xA;        End Using&#xA;    Catch ex As Exception&#xA;        LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] Drive: exception - &quot; &amp; ex.Message &amp; Environment.NewLine&#xA;    End Try&#xA;End If&#xA;driveFetchedCount = downloaded&#xA;" DisplayName="Download Drive files to Incoming" sap2010:WorkflowViewState.IdRef="InvokeCode_8">
