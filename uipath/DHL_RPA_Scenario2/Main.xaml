<ui:InvokeCode ContinueOnError="{x:Null}" Code="' Prepare the single inbox folder structure, resolve secrets from environment variables, start the log.&#xA;RunStartTime = DateTime.Now&#xA;RunId = DateTime.Now.ToString(&quot;yyyyMMdd_HHmmss&quot;)&#xA;&#xA;IncomingDir = System.IO.Path.Combine(InboxRoot, &quot;Incoming&quot;)&#xA;ProcessedDir = System.IO.Path.Combine(InboxRoot, &quot;_processed&quot;)&#xA;FailedDir = System.IO.Path.Combine(InboxRoot, &quot;_failed&quot;)&#xA;ReportsDir = System.IO.Path.Combine(InboxRoot, &quot;_reports&quot;)&#xA;&#xA;Dim folderList As String() = New String() {IncomingDir, ProcessedDir, FailedDir, ReportsDir, System.IO.Path.Combine(ProcessedDir, &quot;duplicates&quot;)}&#xA;For Each d As String In folderList&#xA;    System.IO.Directory.CreateDirectory(d)&#xA;Next&#xA;&#xA;HashLogFile = System.IO.Path.Combine(ProcessedDir, &quot;hashes.csv&quot;)&#xA;RunLogFile = System.IO.Path.Combine(ReportsDir, &quot;run_&quot; &amp; RunId &amp; &quot;.log&quot;)&#xA;ReportCsvFile = System.IO.Path.Combine(ReportsDir, &quot;report_&quot; &amp; RunId &amp; &quot;.csv&quot;)&#xA;&#xA;' OpenAI key: variable first, then process env, then user env (setx OPENAI_API_KEY &quot;sk-...&quot;)&#xA;If String.IsNullOrWhiteSpace(OpenAIApiKey) Then&#xA;    Dim envKey As String = Environment.GetEnvironmentVariable(&quot;OPENAI_API_KEY&quot;)&#xA;    If String.IsNullOrWhiteSpace(envKey) Then&#xA;        envKey = Environment.GetEnvironmentVariable(&quot;OPENAI_API_KEY&quot;, EnvironmentVariableTarget.User)&#xA;    End If&#xA;    If envKey Is Nothing Then&#xA;        envKey = &quot;&quot;&#xA;    End If&#xA;    OpenAIApiKey = envKey.Trim()&#xA;End If&#xA;&#xA;' Backend API key can also be overridden by env var DHL_RPA_API_KEY&#xA;Dim envApi As String = Environment.GetEnvironmentVariable(&quot;DHL_RPA_API_KEY&quot;)&#xA;If String.IsNullOrWhiteSpace(envApi) Then&#xA;    envApi = Environment.GetEnvironmentVariable(&quot;DHL_RPA_API_KEY&quot;, EnvironmentVariableTarget.User)&#xA;End If&#xA;If Not String.IsNullOrWhiteSpace(envApi) Then&#xA;    ApiKey = envApi.Trim()&#xA;End If&#xA;&#xA;Dim stamp As String = &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] &quot;&#xA;LogBuilderStr = stamp &amp; &quot;Run &quot; &amp; RunId &amp; &quot; started.&quot; &amp; Environment.NewLine&#xA;LogBuilderStr = LogBuilderStr &amp; stamp &amp; &quot;Inbox folder: &quot; &amp; IncomingDir &amp; Environment.NewLine&#xA;LogBuilderStr = LogBuilderStr &amp; stamp &amp; &quot;Backend: &quot; &amp; ApiBaseUrl &amp; Environment.NewLine&#xA;If OpenAIApiKey.Length &gt; 0 Then&#xA;    LogBuilderStr = LogBuilderStr &amp; stamp &amp; &quot;OpenAI key found - AI extraction ON (model &quot; &amp; OpenAIModel &amp; &quot;)&quot; &amp; Environment.NewLine&#xA;Else&#xA;    LogBuilderStr = LogBuilderStr &amp; stamp &amp; &quot;WARNING: OpenAI key not set - incidents will use backend rule-based triage only&quot; &amp; Environment.NewLine&#xA;End If&#xA;&#xA;ReportRows = &quot;RunId,Timestamp,CaseKey,Files,ShipmentId,Title,Category,Department,Priority,AIConfidence,AIUsed,IncidentCode,Merged,HttpStatus,Result,Error&quot; &amp; Environment.NewLine&#xA;" DisplayName="1. Init - folders, secrets, run log" sap2010:WorkflowViewState.IdRef="InvokeCode_1">
