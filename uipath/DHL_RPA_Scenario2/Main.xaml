<ui:InvokeCode ContinueOnError="{x:Null}" Code="' Merge the AI extraction with the raw evidence and build the JSON body for POST /api/rpa/import-bundle.&#xA;' Extra &quot;ai&quot; object carries the full structured extraction for the new backend / chatbot (ignored by older backends).&#xA;Dim nl As String = Environment.NewLine&#xA;Dim ai As Newtonsoft.Json.Linq.JObject = Nothing&#xA;If aiOk AndAlso Not String.IsNullOrWhiteSpace(aiJson) Then&#xA;    ai = Newtonsoft.Json.Linq.JObject.Parse(aiJson)&#xA;End If&#xA;&#xA;Dim GetS As Func(Of String, String) = Function(k As String) As String&#xA;                                          If ai Is Nothing Then&#xA;                                              Return &quot;&quot;&#xA;                                          End If&#xA;                                          Dim t As Newtonsoft.Json.Linq.JToken = ai(k)&#xA;                                          If t Is Nothing OrElse t.Type = Newtonsoft.Json.Linq.JTokenType.Null Then&#xA;                                              Return &quot;&quot;&#xA;                                          End If&#xA;                                          Return t.ToString().Trim()&#xA;                                      End Function&#xA;&#xA;Dim GetList As Func(Of String, System.Collections.Generic.List(Of String)) = Function(k As String) As System.Collections.Generic.List(Of String)&#xA;                                                                                 Dim result As New System.Collections.Generic.List(Of String)()&#xA;                                                                                 If ai Is Nothing Then&#xA;                                                                                     Return result&#xA;                                                                                 End If&#xA;                                                                                 Dim arr As Newtonsoft.Json.Linq.JArray = TryCast(ai(k), Newtonsoft.Json.Linq.JArray)&#xA;                                                                                 If arr Is Nothing Then&#xA;                                                                                     Return result&#xA;                                                                                 End If&#xA;                                                                                 For Each item As Newtonsoft.Json.Linq.JToken In arr&#xA;                                                                                     If item.Type = Newtonsoft.Json.Linq.JTokenType.Object Then&#xA;                                                                                         Dim w As String = If(item(&quot;when&quot;) Is Nothing OrElse item(&quot;when&quot;).Type = Newtonsoft.Json.Linq.JTokenType.Null, &quot;&quot;, item(&quot;when&quot;).ToString())&#xA;                                                                                         Dim ev As String = If(item(&quot;event&quot;) Is Nothing, item.ToString(Newtonsoft.Json.Formatting.None), item(&quot;event&quot;).ToString())&#xA;                                                                                         result.Add(If(w.Length &gt; 0, w &amp; &quot;: &quot;, &quot;&quot;) &amp; ev)&#xA;                                                                                     ElseIf item.Type &lt;&gt; Newtonsoft.Json.Linq.JTokenType.Null Then&#xA;                                                                                         result.Add(item.ToString().Trim())&#xA;                                                                                     End If&#xA;                                                                                 Next&#xA;                                                                                 Return result&#xA;                                                                             End Function&#xA;&#xA;Dim Pick As Func(Of String, String(), String, String) = Function(v As String, allowed As String(), dflt As String) As String&#xA;                                                            For Each a As String In allowed&#xA;                                                                If String.Equals(a, v.Trim(), StringComparison.OrdinalIgnoreCase) Then&#xA;                                                                    Return a&#xA;                                                                End If&#xA;                                                            Next&#xA;                                                            Return dflt&#xA;                                                        End Function&#xA;&#xA;Dim Trunc As Func(Of String, Integer, String) = Function(v As String, maxLen As Integer) As String&#xA;                                                    If v Is Nothing Then&#xA;                                                        Return &quot;&quot;&#xA;                                                    End If&#xA;                                                    If v.Length &gt; maxLen Then&#xA;                                                        Return v.Substring(0, maxLen)&#xA;                                                    End If&#xA;                                                    Return v&#xA;                                                End Function&#xA;&#xA;Dim JV As Func(Of String, Newtonsoft.Json.Linq.JToken) = Function(v As String) As Newtonsoft.Json.Linq.JToken&#xA;                                                             If String.IsNullOrWhiteSpace(v) Then&#xA;                                                                 Return Newtonsoft.Json.Linq.JValue.CreateNull()&#xA;                                                             End If&#xA;                                                             Return New Newtonsoft.Json.Linq.JValue(v)&#xA;                                                         End Function&#xA;&#xA;Dim BulletList As Func(Of System.Collections.Generic.List(Of String), String) = Function(lst As System.Collections.Generic.List(Of String)) As String&#xA;                                                                                    Dim b As New System.Text.StringBuilder()&#xA;                                                                                    For Each s As String In lst&#xA;                                                                                        b.Append(&quot;  - &quot;).Append(s).Append(Environment.NewLine)&#xA;                                                                                    Next&#xA;                                                                                    Return b.ToString()&#xA;                                                                                End Function&#xA;&#xA;Dim categories As String() = New String() {&quot;Late Delivery&quot;, &quot;Damaged Parcel&quot;, &quot;Lost Parcel&quot;, &quot;Address Issue&quot;, &quot;Billing&quot;, &quot;System Issue&quot;, &quot;Customer Complaint&quot;, &quot;General&quot;}&#xA;Dim departments As String() = New String() {&quot;Customer Support&quot;, &quot;Operations&quot;, &quot;Logistics Control&quot;, &quot;Warehouse&quot;, &quot;Claims &amp; Insurance&quot;, &quot;Finance&quot;, &quot;IT&quot;}&#xA;Dim priorities As String() = New String() {&quot;Low&quot;, &quot;Medium&quot;, &quot;High&quot;, &quot;Critical&quot;}&#xA;Dim channels As String() = New String() {&quot;Email&quot;, &quot;WhatsApp&quot;, &quot;Teams&quot;, &quot;Call Note&quot;, &quot;Handwritten Note&quot;, &quot;Image&quot;, &quot;Document&quot;, &quot;Other&quot;}&#xA;Dim evidence As String = If(rawText, &quot;&quot;)&#xA;&#xA;' ---- Shipment ID: AI value accepted when it appears in the text (or the case is image-only); else regex&#xA;Dim regexShip As String = &quot;&quot;&#xA;Try&#xA;    regexShip = System.Text.RegularExpressions.Regex.Match(evidence, ShipmentRegex, System.Text.RegularExpressions.RegexOptions.IgnoreCase).Value.ToUpperInvariant()&#xA;Catch rxEx As Exception&#xA;    regexShip = &quot;&quot;&#xA;End Try&#xA;Dim aiShip As String = GetS(&quot;shipment_id&quot;).Replace(&quot; &quot;, &quot;&quot;).ToUpperInvariant()&#xA;If aiShip.Length &gt; 0 AndAlso (evidence.ToUpperInvariant().Contains(aiShip) OrElse regexShip.Length = 0) Then&#xA;    finalShipment = aiShip&#xA;Else&#xA;    finalShipment = regexShip&#xA;End If&#xA;finalShipment = Trunc(finalShipment, 40)&#xA;&#xA;' ---- Title&#xA;finalTitle = GetS(&quot;title&quot;)&#xA;If finalTitle.Length = 0 Then&#xA;    Dim firstLine As String = &quot;&quot;&#xA;    For Each ln As String In evidence.Split(New Char() {ChrW(13), ChrW(10)}, StringSplitOptions.RemoveEmptyEntries)&#xA;        Dim t2 As String = ln.Trim()&#xA;        If t2.Length &gt; 0 AndAlso Not t2.StartsWith(&quot;=====&quot;) AndAlso Not t2.StartsWith(&quot;Channel:&quot;) AndAlso Not t2.StartsWith(&quot;From:&quot;) Then&#xA;            firstLine = t2&#xA;            Exit For&#xA;        End If&#xA;    Next&#xA;    finalTitle = If(firstLine.Length &gt; 0, firstLine, &quot;Incident &quot; &amp; caseKey)&#xA;End If&#xA;finalTitle = Trunc(finalTitle, 120)&#xA;&#xA;' ---- Classification (validated against allowed lists)&#xA;finalCategory = Pick(GetS(&quot;category&quot;), categories, &quot;General&quot;)&#xA;finalDepartment = Pick(GetS(&quot;department&quot;), departments, &quot;Customer Support&quot;)&#xA;finalPriority = Pick(GetS(&quot;priority&quot;), priorities, &quot;Medium&quot;)&#xA;Dim conf As Double = 0&#xA;Double.TryParse(GetS(&quot;confidence&quot;), System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, conf)&#xA;If conf &lt; 0 Then&#xA;    conf = 0&#xA;End If&#xA;If conf &gt; 1 Then&#xA;    conf = 1&#xA;End If&#xA;finalConfidence = conf.ToString(&quot;0.00&quot;, System.Globalization.CultureInfo.InvariantCulture)&#xA;Dim primaryChannel As String = Pick(GetS(&quot;primary_channel&quot;), channels, &quot;Other&quot;)&#xA;&#xA;' ---- Reporter&#xA;Dim reporterName As String = Trunc(GetS(&quot;reporter_name&quot;), 120)&#xA;Dim reporterEmail As String = GetS(&quot;reporter_email&quot;)&#xA;Dim reporterPhone As String = GetS(&quot;reporter_phone&quot;)&#xA;If reporterEmail.Length = 0 Then&#xA;    Dim fm As System.Text.RegularExpressions.Match = System.Text.RegularExpressions.Regex.Match(evidence, &quot;From:\s*(?&lt;n&gt;[^&lt;\r\n]*)&lt;(?&lt;e&gt;[^&gt;\s]+@[^&gt;\s]+)&gt;&quot;)&#xA;    If fm.Success Then&#xA;        reporterEmail = fm.Groups(&quot;e&quot;).Value&#xA;        If reporterName.Length = 0 Then&#xA;            reporterName = Trunc(fm.Groups(&quot;n&quot;).Value.Trim(), 120)&#xA;        End If&#xA;    End If&#xA;End If&#xA;If Not System.Text.RegularExpressions.Regex.IsMatch(reporterEmail, &quot;^[^@\s]+@[^@\s]+\.[^@\s]+$&quot;) Then&#xA;    reporterEmail = &quot;&quot;&#xA;End If&#xA;reporterEmail = Trunc(reporterEmail, 180)&#xA;Dim fromContact As String = If(reporterEmail.Length &gt; 0, reporterEmail, reporterPhone)&#xA;&#xA;' ---- Readable AI block placed at the top of the first source body&#xA;Dim imageFindings As String = GetS(&quot;image_findings&quot;)&#xA;Dim aiBlock As New System.Text.StringBuilder()&#xA;If ai IsNot Nothing Then&#xA;    Dim secondary As System.Collections.Generic.List(Of String) = GetList(&quot;secondary_categories&quot;)&#xA;    aiBlock.Append(&quot;[AI EXTRACTION - OpenAI &quot;).Append(OpenAIModel).Append(&quot; | confidence &quot;).Append(finalConfidence).Append(&quot;]&quot;).Append(nl)&#xA;    aiBlock.Append(&quot;Key problem: &quot;).Append(GetS(&quot;key_problem&quot;)).Append(nl)&#xA;    aiBlock.Append(&quot;Summary: &quot;).Append(GetS(&quot;clean_summary&quot;)).Append(nl)&#xA;    aiBlock.Append(&quot;Category: &quot;).Append(finalCategory)&#xA;    If secondary.Count &gt; 0 Then&#xA;        aiBlock.Append(&quot; (also: &quot;).Append(String.Join(&quot;, &quot;, secondary)).Append(&quot;)&quot;)&#xA;    End If&#xA;    aiBlock.Append(nl)&#xA;    aiBlock.Append(&quot;Department: &quot;).Append(finalDepartment).Append(nl)&#xA;    aiBlock.Append(&quot;Priority: &quot;).Append(finalPriority).Append(&quot; - &quot;).Append(GetS(&quot;priority_reason&quot;)).Append(nl)&#xA;    aiBlock.Append(&quot;Customer sentiment: &quot;).Append(GetS(&quot;customer_sentiment&quot;)).Append(&quot; | Escalation risk: &quot;).Append(If(GetS(&quot;escalation_risk&quot;).ToLowerInvariant() = &quot;true&quot;, &quot;YES&quot;, &quot;no&quot;)).Append(nl)&#xA;    If GetList(&quot;issues_found&quot;).Count &gt; 0 Then&#xA;        aiBlock.Append(&quot;Issues found:&quot;).Append(nl).Append(BulletList(GetList(&quot;issues_found&quot;)))&#xA;    End If&#xA;    If GetList(&quot;missing_information&quot;).Count &gt; 0 Then&#xA;        aiBlock.Append(&quot;Missing information:&quot;).Append(nl).Append(BulletList(GetList(&quot;missing_information&quot;)))&#xA;    End If&#xA;    If GetList(&quot;recommended_actions&quot;).Count &gt; 0 Then&#xA;        aiBlock.Append(&quot;Recommended actions:&quot;).Append(nl).Append(BulletList(GetList(&quot;recommended_actions&quot;)))&#xA;    End If&#xA;    If GetList(&quot;timeline&quot;).Count &gt; 0 Then&#xA;        aiBlock.Append(&quot;Timeline:&quot;).Append(nl).Append(BulletList(GetList(&quot;timeline&quot;)))&#xA;    End If&#xA;    If imageFindings.Length &gt; 0 Then&#xA;        aiBlock.Append(&quot;Image findings: &quot;).Append(imageFindings).Append(nl)&#xA;    End If&#xA;    aiBlock.Append(nl).Append(&quot;----- ORIGINAL EVIDENCE -----&quot;).Append(nl)&#xA;Else&#xA;    aiBlock.Append(&quot;[AI extraction unavailable - classified by backend rules]&quot;).Append(nl).Append(nl)&#xA;End If&#xA;&#xA;' ---- Sources (one per file)&#xA;Dim srcIn As Newtonsoft.Json.Linq.JArray = Newtonsoft.Json.Linq.JArray.Parse(sourcesJson)&#xA;Dim sources As New Newtonsoft.Json.Linq.JArray()&#xA;Dim textSourceCount As Integer = 0&#xA;For Each tok As Newtonsoft.Json.Linq.JToken In srcIn&#xA;    If tok(&quot;kind&quot;).ToString() = &quot;text&quot; OrElse tok(&quot;kind&quot;).ToString() = &quot;document&quot; Then&#xA;        textSourceCount = textSourceCount + 1&#xA;    End If&#xA;Next&#xA;&#xA;Dim isFirst As Boolean = True&#xA;For Each tok As Newtonsoft.Json.Linq.JToken In srcIn&#xA;    Dim fileNm As String = tok(&quot;file&quot;).ToString()&#xA;    Dim kind As String = tok(&quot;kind&quot;).ToString()&#xA;    Dim ch As String = tok(&quot;channel&quot;).ToString()&#xA;    Dim body As String = tok(&quot;text&quot;).ToString()&#xA;    If ch = &quot;Upload&quot; Then&#xA;        ch = If(textSourceCount = 1 AndAlso primaryChannel &lt;&gt; &quot;Other&quot;, primaryChannel, &quot;Upload&quot;)&#xA;    End If&#xA;    If kind = &quot;image&quot; Then&#xA;        body = &quot;[Image evidence: &quot; &amp; fileNm &amp; &quot;]&quot;&#xA;        If imageFindings.Length &gt; 0 Then&#xA;            body = body &amp; nl &amp; &quot;AI image findings: &quot; &amp; imageFindings&#xA;        End If&#xA;    ElseIf kind = &quot;pdf&quot; Then&#xA;        body = &quot;[PDF document: &quot; &amp; fileNm &amp; &quot;]&quot; &amp; If(ai IsNot Nothing, &quot; - content read by AI, see summary above.&quot;, &quot;&quot;)&#xA;    ElseIf kind = &quot;unsupported&quot; Then&#xA;        body = &quot;[Unsupported file type: &quot; &amp; fileNm &amp; &quot;]&quot;&#xA;    End If&#xA;    If isFirst Then&#xA;        body = aiBlock.ToString() &amp; body&#xA;        isFirst = False&#xA;    End If&#xA;    If String.IsNullOrWhiteSpace(body) Then&#xA;        body = &quot;(empty file: &quot; &amp; fileNm &amp; &quot;)&quot;&#xA;    End If&#xA;&#xA;    Dim o As New Newtonsoft.Json.Linq.JObject()&#xA;    o.Add(&quot;channel&quot;, New Newtonsoft.Json.Linq.JValue(Trunc(ch, 60)))&#xA;    o.Add(&quot;subject&quot;, New Newtonsoft.Json.Linq.JValue(Trunc(finalTitle, 250)))&#xA;    o.Add(&quot;body&quot;, New Newtonsoft.Json.Linq.JValue(body))&#xA;    o.Add(&quot;fromName&quot;, JV(Trunc(reporterName, 150)))&#xA;    o.Add(&quot;fromContact&quot;, JV(Trunc(fromContact, 180)))&#xA;    o.Add(&quot;sourceTimestamp&quot;, JV(tok(&quot;timestamp&quot;).ToString()))&#xA;    o.Add(&quot;attachmentName&quot;, JV(Trunc(fileNm, 255)))&#xA;    o.Add(&quot;externalReference&quot;, JV(Trunc(caseKey &amp; &quot;/&quot; &amp; fileNm, 180)))&#xA;    sources.Add(o)&#xA;Next&#xA;&#xA;' ---- Structured AI object (for the new backend, dashboard and chatbot)&#xA;Dim aiObj As New Newtonsoft.Json.Linq.JObject()&#xA;aiObj.Add(&quot;provider&quot;, New Newtonsoft.Json.Linq.JValue(&quot;OpenAI&quot;))&#xA;aiObj.Add(&quot;model&quot;, New Newtonsoft.Json.Linq.JValue(OpenAIModel))&#xA;aiObj.Add(&quot;used&quot;, New Newtonsoft.Json.Linq.JValue(ai IsNot Nothing))&#xA;aiObj.Add(&quot;keyProblem&quot;, JV(GetS(&quot;key_problem&quot;)))&#xA;aiObj.Add(&quot;cleanSummary&quot;, JV(GetS(&quot;clean_summary&quot;)))&#xA;aiObj.Add(&quot;category&quot;, New Newtonsoft.Json.Linq.JValue(finalCategory))&#xA;aiObj.Add(&quot;secondaryCategories&quot;, New Newtonsoft.Json.Linq.JArray(GetList(&quot;secondary_categories&quot;).ToArray()))&#xA;aiObj.Add(&quot;department&quot;, New Newtonsoft.Json.Linq.JValue(finalDepartment))&#xA;aiObj.Add(&quot;priority&quot;, New Newtonsoft.Json.Linq.JValue(finalPriority))&#xA;aiObj.Add(&quot;priorityReason&quot;, JV(GetS(&quot;priority_reason&quot;)))&#xA;aiObj.Add(&quot;primaryChannel&quot;, New Newtonsoft.Json.Linq.JValue(primaryChannel))&#xA;aiObj.Add(&quot;customerSentiment&quot;, JV(GetS(&quot;customer_sentiment&quot;)))&#xA;aiObj.Add(&quot;escalationRisk&quot;, New Newtonsoft.Json.Linq.JValue(GetS(&quot;escalation_risk&quot;).ToLowerInvariant() = &quot;true&quot;))&#xA;aiObj.Add(&quot;issuesFound&quot;, New Newtonsoft.Json.Linq.JArray(GetList(&quot;issues_found&quot;).ToArray()))&#xA;aiObj.Add(&quot;missingInformation&quot;, New Newtonsoft.Json.Linq.JArray(GetList(&quot;missing_information&quot;).ToArray()))&#xA;aiObj.Add(&quot;recommendedActions&quot;, New Newtonsoft.Json.Linq.JArray(GetList(&quot;recommended_actions&quot;).ToArray()))&#xA;aiObj.Add(&quot;timeline&quot;, New Newtonsoft.Json.Linq.JArray(GetList(&quot;timeline&quot;).ToArray()))&#xA;aiObj.Add(&quot;imageFindings&quot;, JV(imageFindings))&#xA;aiObj.Add(&quot;incidentDate&quot;, JV(GetS(&quot;incident_date&quot;)))&#xA;aiObj.Add(&quot;reporterPhone&quot;, JV(reporterPhone))&#xA;aiObj.Add(&quot;confidence&quot;, New Newtonsoft.Json.Linq.JValue(conf))&#xA;aiObj.Add(&quot;error&quot;, JV(aiError))&#xA;&#xA;Dim payload As New Newtonsoft.Json.Linq.JObject()&#xA;payload.Add(&quot;shipmentId&quot;, JV(finalShipment))&#xA;payload.Add(&quot;title&quot;, New Newtonsoft.Json.Linq.JValue(Trunc(finalTitle, 180)))&#xA;payload.Add(&quot;sources&quot;, sources)&#xA;payload.Add(&quot;reporterName&quot;, JV(reporterName))&#xA;payload.Add(&quot;reporterEmail&quot;, JV(reporterEmail))&#xA;payload.Add(&quot;externalReference&quot;, New Newtonsoft.Json.Linq.JValue(Trunc(&quot;UIPATH-&quot; &amp; RunId &amp; &quot;-&quot; &amp; caseKey, 180)))&#xA;payload.Add(&quot;ai&quot;, aiObj)&#xA;payloadJson = payload.ToString(Newtonsoft.Json.Formatting.None)&#xA;&#xA;If ai IsNot Nothing Then&#xA;    statusNote = Trunc(&quot;UiPath + OpenAI triage: &quot; &amp; finalCategory &amp; &quot; -&gt; &quot; &amp; finalDepartment &amp; &quot;, priority &quot; &amp; finalPriority &amp; &quot; (confidence &quot; &amp; finalConfidence &amp; &quot;)&quot;, 200)&#xA;Else&#xA;    statusNote = &quot;UiPath import - AI unavailable, rule-based triage by backend&quot;&#xA;End If&#xA;" DisplayName="5c. Build incident bundle (AI + raw evidence)" sap2010:WorkflowViewState.IdRef="InvokeCode_22">
