<ui:InvokeCode ContinueOnError="{x:Null}" Code="' Save each fetched email (body + attachments) into the single Incoming folder.&#xA;' Files from one email share a case key prefix &quot;EMAIL-&lt;timestamp&gt;-&lt;n&gt;__&quot; so they are analysed together.&#xA;Dim saved As Integer = 0&#xA;Dim n As Integer = 0&#xA;If mailMessages IsNot Nothing Then&#xA;    For Each msg As System.Net.Mail.MailMessage In mailMessages&#xA;        n = n + 1&#xA;        Try&#xA;            Dim subj As String = If(msg.Subject, &quot;&quot;)&#xA;            Dim bodyText As String = If(msg.Body, &quot;&quot;)&#xA;            If msg.IsBodyHtml Then&#xA;                bodyText = System.Text.RegularExpressions.Regex.Replace(bodyText, &quot;&lt;(br|/p|/div|/tr|/li)[^&gt;]*&gt;&quot;, Environment.NewLine, System.Text.RegularExpressions.RegexOptions.IgnoreCase)&#xA;                bodyText = System.Text.RegularExpressions.Regex.Replace(bodyText, &quot;&lt;[^&gt;]+&gt;&quot;, &quot; &quot;)&#xA;                bodyText = System.Web.HttpUtility.HtmlDecode(bodyText)&#xA;            End If&#xA;&#xA;            Dim fromAddr As String = &quot;&quot;&#xA;            Dim fromName As String = &quot;&quot;&#xA;            If msg.From IsNot Nothing Then&#xA;                fromAddr = If(msg.From.Address, &quot;&quot;)&#xA;                fromName = If(msg.From.DisplayName, &quot;&quot;)&#xA;            End If&#xA;&#xA;            Dim sentDate As String = &quot;&quot;&#xA;            If msg.Headers IsNot Nothing AndAlso msg.Headers(&quot;Date&quot;) IsNot Nothing Then&#xA;                sentDate = msg.Headers(&quot;Date&quot;)&#xA;            End If&#xA;&#xA;            Dim mailKey As String = &quot;EMAIL-&quot; &amp; DateTime.Now.ToString(&quot;yyyyMMddHHmmssfff&quot;) &amp; &quot;-&quot; &amp; n.ToString(&quot;000&quot;)&#xA;            Dim textOut As String = &quot;Channel: Email&quot; &amp; Environment.NewLine &amp;&#xA;                                    &quot;From: &quot; &amp; fromName &amp; &quot; &lt;&quot; &amp; fromAddr &amp; &quot;&gt;&quot; &amp; Environment.NewLine &amp;&#xA;                                    &quot;Subject: &quot; &amp; subj &amp; Environment.NewLine &amp;&#xA;                                    &quot;Date: &quot; &amp; sentDate &amp; Environment.NewLine &amp;&#xA;                                    Environment.NewLine &amp; bodyText&#xA;            System.IO.File.WriteAllText(System.IO.Path.Combine(IncomingDir, mailKey &amp; &quot;__email.txt&quot;), textOut, System.Text.Encoding.UTF8)&#xA;&#xA;            Dim attCount As Integer = 0&#xA;            For Each att As System.Net.Mail.Attachment In msg.Attachments&#xA;                Try&#xA;                    Dim attName As String = If(String.IsNullOrWhiteSpace(att.Name), &quot;attachment.bin&quot;, att.Name)&#xA;                    For Each bad As Char In System.IO.Path.GetInvalidFileNameChars()&#xA;                        attName = attName.Replace(bad, &quot;_&quot;c)&#xA;                    Next&#xA;                    attName = attName.Replace(&quot;__&quot;, &quot;_&quot;)&#xA;                    If att.ContentStream.CanSeek Then&#xA;                        att.ContentStream.Position = 0&#xA;                    End If&#xA;                    Using fs As New System.IO.FileStream(System.IO.Path.Combine(IncomingDir, mailKey &amp; &quot;__att_&quot; &amp; attName), System.IO.FileMode.Create)&#xA;                        att.ContentStream.CopyTo(fs)&#xA;                    End Using&#xA;                    attCount = attCount + 1&#xA;                Catch attEx As Exception&#xA;                    LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] WARN could not save attachment: &quot; &amp; attEx.Message &amp; Environment.NewLine&#xA;                End Try&#xA;            Next&#xA;&#xA;            saved = saved + 1&#xA;            LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] Gmail: saved '&quot; &amp; subj &amp; &quot;' from &quot; &amp; fromAddr &amp; &quot; (&quot; &amp; attCount.ToString() &amp; &quot; attachment(s)) as &quot; &amp; mailKey &amp; Environment.NewLine&#xA;        Catch ex As Exception&#xA;            LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] ERROR saving email #&quot; &amp; n.ToString() &amp; &quot;: &quot; &amp; ex.Message &amp; Environment.NewLine&#xA;        End Try&#xA;    Next&#xA;End If&#xA;gmailFetchedCount = saved&#xA;" DisplayName="Save emails + attachments to Incoming" sap2010:WorkflowViewState.IdRef="InvokeCode_3">
