<ui:InvokeCode ContinueOnError="{x:Null}" Code="' Group every file in the single Incoming folder into &quot;cases&quot;.&#xA;' Case key = text before the first &quot;__&quot; in the file name (e.g. EMAIL-2026...-001__email.txt + EMAIL-2026...-001__att_photo.jpg),&#xA;' otherwise the file name without extension (each loose file is its own case).&#xA;Dim groups As New System.Collections.Generic.Dictionary(Of String, System.Collections.Generic.List(Of String))(StringComparer.OrdinalIgnoreCase)&#xA;Dim order As New System.Collections.Generic.List(Of String)()&#xA;&#xA;For Each f As String In System.IO.Directory.GetFiles(IncomingDir)&#xA;    Dim nm As String = System.IO.Path.GetFileName(f)&#xA;    If nm.StartsWith(&quot;~$&quot;) OrElse nm.StartsWith(&quot;.&quot;) OrElse nm.EndsWith(&quot;.tmp&quot;, StringComparison.OrdinalIgnoreCase) OrElse nm.Equals(&quot;desktop.ini&quot;, StringComparison.OrdinalIgnoreCase) OrElse nm.Equals(&quot;Thumbs.db&quot;, StringComparison.OrdinalIgnoreCase) Then&#xA;        Continue For&#xA;    End If&#xA;    Dim groupKey As String&#xA;    Dim p As Integer = nm.IndexOf(&quot;__&quot;)&#xA;    If p &gt; 0 Then&#xA;        groupKey = nm.Substring(0, p)&#xA;    Else&#xA;        groupKey = System.IO.Path.GetFileNameWithoutExtension(nm)&#xA;    End If&#xA;    If Not groups.ContainsKey(groupKey) Then&#xA;        groups(groupKey) = New System.Collections.Generic.List(Of String)()&#xA;        order.Add(groupKey)&#xA;    End If&#xA;    groups(groupKey).Add(f)&#xA;Next&#xA;&#xA;caseList = New System.Collections.Generic.List(Of String())()&#xA;For Each k As String In order&#xA;    Dim lst As System.Collections.Generic.List(Of String) = groups(k)&#xA;    lst.Sort(StringComparer.OrdinalIgnoreCase)&#xA;    caseList.Add(lst.ToArray())&#xA;Next&#xA;caseCount = caseList.Count&#xA;LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] Found &quot; &amp; caseCount.ToString() &amp; &quot; case(s) in &quot; &amp; IncomingDir &amp; Environment.NewLine&#xA;" DisplayName="4. Group Incoming files into cases" sap2010:WorkflowViewState.IdRef="InvokeCode_12">
