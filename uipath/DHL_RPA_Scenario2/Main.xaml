<ui:InvokeCode ContinueOnError="{x:Null}" Code="' Send all evidence of the case (text + images + PDFs) to OpenAI Chat Completions in JSON mode&#xA;' and get back one structured incident record. Retries on 429 / 5xx / network errors.&#xA;aiOk = False&#xA;aiError = &quot;&quot;&#xA;aiJson = &quot;&quot;&#xA;Dim stamp As String = &quot;[&quot; &amp; DateTime.Now.ToString(&quot;yyyy-MM-dd HH:mm:ss&quot;) &amp; &quot;] &quot;&#xA;&#xA;Try&#xA;    Dim nl As String = vbLf&#xA;    Dim systemPrompt As String = &quot;You are an incident-intake analyst for DHL Customer Support (Asia Pacific). You receive raw, messy incident evidence: &quot; &amp;&#xA;        &quot;customer emails, WhatsApp or Teams chats, call-centre notes, handwritten warehouse notes, photos of damaged parcels and screenshots. &quot; &amp;&#xA;        &quot;Read ALL the evidence (text, images and PDFs) and return ONE JSON object that describes the incident. &quot; &amp;&#xA;        &quot;Use only facts present in the evidence. Never invent shipment numbers, names, emails or dates - use null when unknown.&quot; &amp; nl &amp; nl &amp;&#xA;        &quot;Return exactly these keys:&quot; &amp; nl &amp;&#xA;        &quot;shipment_id: string or null - the DHL shipment / tracking number exactly as written (e.g. MY987623400).&quot; &amp; nl &amp;&#xA;        &quot;title: string, max 100 characters, specific (e.g. &quot;&quot;Damaged coffee machine on MY987623400 - delivered late, no exception scan&quot;&quot;).&quot; &amp; nl &amp;&#xA;        &quot;primary_channel: one of Email, WhatsApp, Teams, Call Note, Handwritten Note, Image, Document, Other.&quot; &amp; nl &amp;&#xA;        &quot;reporter_name: string or null. reporter_email: string or null. reporter_phone: string or null.&quot; &amp; nl &amp;&#xA;        &quot;incident_date: YYYY-MM-DD or null.&quot; &amp; nl &amp;&#xA;        &quot;key_problem: one sentence stating the real underlying issue.&quot; &amp; nl &amp;&#xA;        &quot;clean_summary: 3 to 5 neutral sentences a supervisor can read in 20 seconds.&quot; &amp; nl &amp;&#xA;        &quot;category: one of Late Delivery, Damaged Parcel, Lost Parcel, Address Issue, Billing, System Issue, Customer Complaint, General.&quot; &amp; nl &amp;&#xA;        &quot;secondary_categories: array of other values from the same list that also apply (exclude category).&quot; &amp; nl &amp;&#xA;        &quot;department: one of Customer Support, Operations, Logistics Control, Warehouse, Claims &amp; Insurance, Finance, IT.&quot; &amp; nl &amp;&#xA;        &quot;priority: one of Low, Medium, High, Critical.&quot; &amp; nl &amp;&#xA;        &quot;priority_reason: one sentence.&quot; &amp; nl &amp;&#xA;        &quot;customer_sentiment: one of Calm, Frustrated, Angry, Escalation Threat.&quot; &amp; nl &amp;&#xA;        &quot;escalation_risk: boolean.&quot; &amp; nl &amp;&#xA;        &quot;issues_found: array of short strings (every distinct problem, e.g. late delivery, missing exception scan).&quot; &amp; nl &amp;&#xA;        &quot;missing_information: array of short strings (what an agent still needs to ask or find).&quot; &amp; nl &amp;&#xA;        &quot;recommended_actions: array of 2 to 5 short imperative next steps.&quot; &amp; nl &amp;&#xA;        &quot;timeline: array of objects {&quot;&quot;when&quot;&quot;: string or null, &quot;&quot;event&quot;&quot;: string} in chronological order.&quot; &amp; nl &amp;&#xA;        &quot;image_findings: string or null - what the photos or screenshots show; null when there are no images.&quot; &amp; nl &amp;&#xA;        &quot;confidence: number from 0 to 1 - your confidence in category, department and priority.&quot; &amp; nl &amp; nl &amp;&#xA;        &quot;Priority rules: Critical = safety risk, VIP or key account, legal / social-media / press threat together with damage or loss, or many customers affected. &quot; &amp;&#xA;        &quot;High = damaged, lost or significantly late shipment, or a customer demanding refund or replacement. &quot; &amp;&#xA;        &quot;Medium = billing questions, address changes, single delay without loss. Low = general enquiry.&quot; &amp; nl &amp;&#xA;        &quot;Department rules: refund or replacement claim for damage or loss -&gt; Claims &amp; Insurance; damage caused in handling or linehaul without a claim -&gt; Operations; &quot; &amp;&#xA;        &quot;lost parcels and missing scans -&gt; Logistics Control; hub, pallet or storage problems -&gt; Warehouse; invoices and payments only -&gt; Finance; &quot; &amp;&#xA;        &quot;portal, app or tracking system faults -&gt; IT; everything else -&gt; Customer Support.&quot; &amp; nl &amp;&#xA;        &quot;Respond with the JSON object only.&quot;&#xA;&#xA;    Dim evidence As String = If(rawText, &quot;&quot;)&#xA;    If evidence.Length &gt; 30000 Then&#xA;        evidence = evidence.Substring(0, 30000) &amp; vbLf &amp; &quot;[...truncated...]&quot;&#xA;    End If&#xA;    If evidence.Trim().Length = 0 Then&#xA;        evidence = &quot;(no text evidence - analyse the attached images / documents)&quot;&#xA;    End If&#xA;&#xA;    Dim imgList As String() = If(imageFiles, New String() {})&#xA;    Dim pdfList As String() = If(pdfFiles, New String() {})&#xA;&#xA;    Dim parts As New Newtonsoft.Json.Linq.JArray()&#xA;    Dim textPart As New Newtonsoft.Json.Linq.JObject()&#xA;    textPart.Add(&quot;type&quot;, New Newtonsoft.Json.Linq.JValue(&quot;text&quot;))&#xA;    textPart.Add(&quot;text&quot;, New Newtonsoft.Json.Linq.JValue(&quot;Case key: &quot; &amp; caseKey &amp; vbLf &amp; &quot;Attached images: &quot; &amp; imgList.Length.ToString() &amp; &quot;, PDFs: &quot; &amp; pdfList.Length.ToString() &amp; vbLf &amp; vbLf &amp; &quot;EVIDENCE TEXT:&quot; &amp; vbLf &amp; evidence))&#xA;    parts.Add(textPart)&#xA;&#xA;    Dim maxBytes As Long = CLng(MaxAttachmentMB) * 1024L * 1024L&#xA;    Dim imgUsed As Integer = 0&#xA;    For Each img As String In imgList&#xA;        If imgUsed &gt;= 8 Then&#xA;            Exit For&#xA;        End If&#xA;        Dim info As New System.IO.FileInfo(img)&#xA;        If info.Length &gt; maxBytes Then&#xA;            LogBuilderStr = LogBuilderStr &amp; stamp &amp; &quot;AI: skipped large image &quot; &amp; info.Name &amp; Environment.NewLine&#xA;            Continue For&#xA;        End If&#xA;        Dim ext As String = info.Extension.ToLowerInvariant()&#xA;        Dim mime As String = &quot;image/jpeg&quot;&#xA;        If ext = &quot;.png&quot; Then&#xA;            mime = &quot;image/png&quot;&#xA;        ElseIf ext = &quot;.webp&quot; Then&#xA;            mime = &quot;image/webp&quot;&#xA;        ElseIf ext = &quot;.gif&quot; Then&#xA;            mime = &quot;image/gif&quot;&#xA;        End If&#xA;        Dim imgObj As New Newtonsoft.Json.Linq.JObject()&#xA;        imgObj.Add(&quot;url&quot;, New Newtonsoft.Json.Linq.JValue(&quot;data:&quot; &amp; mime &amp; &quot;;base64,&quot; &amp; Convert.ToBase64String(System.IO.File.ReadAllBytes(img))))&#xA;        imgObj.Add(&quot;detail&quot;, New Newtonsoft.Json.Linq.JValue(&quot;high&quot;))&#xA;        Dim imgPart As New Newtonsoft.Json.Linq.JObject()&#xA;        imgPart.Add(&quot;type&quot;, New Newtonsoft.Json.Linq.JValue(&quot;image_url&quot;))&#xA;        imgPart.Add(&quot;image_url&quot;, imgObj)&#xA;        parts.Add(imgPart)&#xA;        imgUsed = imgUsed + 1&#xA;    Next&#xA;&#xA;    Dim pdfUsed As Integer = 0&#xA;    For Each pdf As String In pdfList&#xA;        If pdfUsed &gt;= 3 Then&#xA;            Exit For&#xA;        End If&#xA;        Dim pinfo As New System.IO.FileInfo(pdf)&#xA;        If pinfo.Length &gt; maxBytes Then&#xA;            LogBuilderStr = LogBuilderStr &amp; stamp &amp; &quot;AI: skipped large PDF &quot; &amp; pinfo.Name &amp; Environment.NewLine&#xA;            Continue For&#xA;        End If&#xA;        Dim fileObj As New Newtonsoft.Json.Linq.JObject()&#xA;        fileObj.Add(&quot;filename&quot;, New Newtonsoft.Json.Linq.JValue(pinfo.Name))&#xA;        fileObj.Add(&quot;file_data&quot;, New Newtonsoft.Json.Linq.JValue(&quot;data:application/pdf;base64,&quot; &amp; Convert.ToBase64String(System.IO.File.ReadAllBytes(pdf))))&#xA;        Dim pdfPart As New Newtonsoft.Json.Linq.JObject()&#xA;        pdfPart.Add(&quot;type&quot;, New Newtonsoft.Json.Linq.JValue(&quot;file&quot;))&#xA;        pdfPart.Add(&quot;file&quot;, fileObj)&#xA;        parts.Add(pdfPart)&#xA;        pdfUsed = pdfUsed + 1&#xA;    Next&#xA;&#xA;    Dim sysMsg As New Newtonsoft.Json.Linq.JObject()&#xA;    sysMsg.Add(&quot;role&quot;, New Newtonsoft.Json.Linq.JValue(&quot;system&quot;))&#xA;    sysMsg.Add(&quot;content&quot;, New Newtonsoft.Json.Linq.JValue(systemPrompt))&#xA;    Dim usrMsg As New Newtonsoft.Json.Linq.JObject()&#xA;    usrMsg.Add(&quot;role&quot;, New Newtonsoft.Json.Linq.JValue(&quot;user&quot;))&#xA;    usrMsg.Add(&quot;content&quot;, parts)&#xA;    Dim msgs As New Newtonsoft.Json.Linq.JArray()&#xA;    msgs.Add(sysMsg)&#xA;    msgs.Add(usrMsg)&#xA;&#xA;    Dim respFormat As New Newtonsoft.Json.Linq.JObject()&#xA;    respFormat.Add(&quot;type&quot;, New Newtonsoft.Json.Linq.JValue(&quot;json_object&quot;))&#xA;&#xA;    Dim req As New Newtonsoft.Json.Linq.JObject()&#xA;    req.Add(&quot;model&quot;, New Newtonsoft.Json.Linq.JValue(OpenAIModel))&#xA;    req.Add(&quot;temperature&quot;, New Newtonsoft.Json.Linq.JValue(0.1))&#xA;    req.Add(&quot;response_format&quot;, respFormat)&#xA;    req.Add(&quot;messages&quot;, msgs)&#xA;    Dim reqBody As String = req.ToString(Newtonsoft.Json.Formatting.None)&#xA;&#xA;    Dim respBody As String = &quot;&quot;&#xA;    Dim code As Integer = 0&#xA;    Using http As New System.Net.Http.HttpClient()&#xA;        http.Timeout = TimeSpan.FromSeconds(180)&#xA;        http.DefaultRequestHeaders.Authorization = New System.Net.Http.Headers.AuthenticationHeaderValue(&quot;Bearer&quot;, OpenAIApiKey)&#xA;        For attempt As Integer = 1 To 3&#xA;            Try&#xA;                Using reqContent As New System.Net.Http.StringContent(reqBody, System.Text.Encoding.UTF8, &quot;application/json&quot;)&#xA;                    Dim resp As System.Net.Http.HttpResponseMessage = http.PostAsync(OpenAIEndpoint, reqContent).Result&#xA;                    code = CInt(resp.StatusCode)&#xA;                    respBody = resp.Content.ReadAsStringAsync().Result&#xA;                End Using&#xA;            Catch netEx As Exception&#xA;                code = 0&#xA;                Dim inner As Exception = netEx&#xA;                While inner.InnerException IsNot Nothing&#xA;                    inner = inner.InnerException&#xA;                End While&#xA;                respBody = inner.Message&#xA;            End Try&#xA;            If code = 200 Then&#xA;                Exit For&#xA;            End If&#xA;            If code &lt;&gt; 0 AndAlso code &lt;&gt; 429 AndAlso code &lt; 500 Then&#xA;                Exit For&#xA;            End If&#xA;            LogBuilderStr = LogBuilderStr &amp; stamp &amp; &quot;AI: attempt &quot; &amp; attempt.ToString() &amp; &quot; failed (HTTP &quot; &amp; code.ToString() &amp; &quot;), retrying&quot; &amp; Environment.NewLine&#xA;            System.Threading.Thread.Sleep(attempt * 4000)&#xA;        Next&#xA;    End Using&#xA;&#xA;    If code = 200 Then&#xA;        Dim root As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(respBody)&#xA;        Dim contentTok As Newtonsoft.Json.Linq.JToken = root.SelectToken(&quot;choices[0].message.content&quot;)&#xA;        If contentTok Is Nothing OrElse contentTok.Type = Newtonsoft.Json.Linq.JTokenType.Null Then&#xA;            aiError = &quot;OpenAI returned no message content&quot;&#xA;        Else&#xA;            Dim txt As String = contentTok.ToString().Trim()&#xA;            If txt.StartsWith(&quot;```&quot;) Then&#xA;                txt = System.Text.RegularExpressions.Regex.Replace(txt, &quot;^```[a-zA-Z]*\s*|\s*```$&quot;, &quot;&quot;)&#xA;            End If&#xA;            Dim parsed As Newtonsoft.Json.Linq.JObject = Newtonsoft.Json.Linq.JObject.Parse(txt)&#xA;            aiJson = parsed.ToString(Newtonsoft.Json.Formatting.None)&#xA;            aiOk = True&#xA;            Dim usedTokens As String = &quot;&quot;&#xA;            Dim usageTok As Newtonsoft.Json.Linq.JToken = root.SelectToken(&quot;usage.total_tokens&quot;)&#xA;            If usageTok IsNot Nothing Then&#xA;                usedTokens = usageTok.ToString()&#xA;            End If&#xA;            LogBuilderStr = LogBuilderStr &amp; stamp &amp; &quot;AI: &quot; &amp; caseKey &amp; &quot; extracted OK (&quot; &amp; imgUsed.ToString() &amp; &quot; image(s), &quot; &amp; pdfUsed.ToString() &amp; &quot; PDF(s), tokens &quot; &amp; usedTokens &amp; &quot;)&quot; &amp; Environment.NewLine&#xA;        End If&#xA;    Else&#xA;        Dim shortBody As String = If(respBody, &quot;&quot;)&#xA;        If shortBody.Length &gt; 300 Then&#xA;            shortBody = shortBody.Substring(0, 300)&#xA;        End If&#xA;        aiError = &quot;OpenAI HTTP &quot; &amp; code.ToString() &amp; &quot;: &quot; &amp; shortBody&#xA;    End If&#xA;Catch ex As Exception&#xA;    aiOk = False&#xA;    aiError = &quot;OpenAI step error: &quot; &amp; ex.Message&#xA;End Try&#xA;&#xA;If Not aiOk Then&#xA;    LogBuilderStr = LogBuilderStr &amp; stamp &amp; &quot;AI: &quot; &amp; caseKey &amp; &quot; FALLBACK to rule-based triage - &quot; &amp; aiError &amp; Environment.NewLine&#xA;End If&#xA;" DisplayName="OpenAI - extract key problem, summary, classification" sap2010:WorkflowViewState.IdRef="InvokeCode_17">
<ui:InvokeCode.Arguments>
