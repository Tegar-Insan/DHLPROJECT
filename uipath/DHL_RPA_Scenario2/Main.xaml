&amp; DateTime.Now.ToString(&quot;HHmmssfff&quot;) &amp; System.IO.Path.GetExtension(f))&#xA;            End If&#xA;            System.IO.File.Move(f, dest)&#xA;        End If&#xA;    Catch mvEx As Exception&#xA;        LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; stamp &amp; &quot;] WARN could not move &quot; &amp; f &amp; &quot;: &quot; &amp; mvEx.Message &amp; Environment.NewLine&#xA;    End Try&#xA;Next&#xA;&#xA;Dim errText As String = If(caseError, &quot;&quot;)&#xA;If Not aiOk AndAlso Not String.IsNullOrWhiteSpace(aiError) Then&#xA;    errText = (errText &amp; &quot; | AI: &quot; &amp; aiError).Trim(&quot; &quot;c, &quot;|&quot;c)&#xA;End If&#xA;&#xA;ReportRows = ReportRows &amp; String.Join(&quot;,&quot;, New String() {&#xA;    Q(RunId), Q(stamp), Q(caseKey), Q(String.Join(&quot;; &quot;, names)), Q(finalShipment), Q(finalTitle),&#xA;    Q(finalCategory), Q(finalDepartment), Q(finalPriority), Q(finalConfidence), Q(If(aiOk, &quot;Yes&quot;, &quot;No&quot;)),&#xA;    Q(incidentCode), Q(If(mergedFlag, &quot;Yes&quot;, &quot;No&quot;)), Q(httpStatus.ToString()), Q(caseResult), Q(errText)}) &amp; Environment.NewLine&#xA;&#xA;LogBuilderStr = LogBuilderStr &amp; &quot;[&quot; &amp; stamp &amp; &quot;] CASE &quot; &amp; caseKey &amp; &quot; -&gt; &quot; &amp; caseResult &amp;&#xA;                If(incidentCode.Length &gt; 0, &quot; &quot; &amp; incidentCode, &quot;&quot;) &amp;&#xA;                &quot; | &quot; &amp; finalCategory &amp; &quot; / &quot; &amp; finalDepartment &amp; &quot; / &quot; &amp; finalPriority &amp;&#xA;                &quot; | shipment &quot; &amp; If(finalShipment.Length &gt; 0, finalShipment, &quot;-&quot;) &amp;&#xA;                If(errText.Length &gt; 0, &quot; | &quot; &amp; errText, &quot;&quot;) &amp; Environment.NewLine&#xA;" DisplayName="5g. Record hash, report row, move files" sap2010:WorkflowViewState.IdRef="InvokeCode_27">
