<ui:InvokeCode ContinueOnError="{x:Null}" Code="' POST the bundle to the web app. Retries 3x on network errors and 5xx.&#xA;responseText = &quot;&quot;&#xA;httpStatus = 0&#xA;Dim url As String = ApiBaseUrl.TrimEnd(&quot;/&quot;c) &amp; BundlePath&#xA;Using http As New System.Net.Http.HttpClient()&#xA;    http.Timeout = TimeSpan.FromSeconds(60)&#xA;    http.DefaultRequestHeaders.Add(&quot;X-Api-Key&quot;, ApiKey)&#xA;    For attempt As Integer = 1 To 3&#xA;        Try&#xA;            Using body As New System.Net.Http.StringContent(payloadJson, System.Text.Encoding.UTF8, &quot;application/json&quot;)&#xA;                Dim resp As System.Net.Http.HttpResponseMessage = http.PostAsync(url, body).Result&#xA;                httpStatus = CInt(resp.StatusCode)&#xA;                responseText = resp.Content.ReadAsStringAsync().Result&#xA;            End Using&#xA;        Catch ex As Exception&#xA;            httpStatus = 0&#xA;            Dim inner As Exception = ex&#xA;            While inner.InnerException IsNot Nothing&#xA;                inner = inner.InnerException&#xA;            End While&#xA;            responseText = &quot;{&quot;&quot;ok&quot;&quot;:false,&quot;&quot;message&quot;&quot;:&quot; &amp; Newtonsoft.Json.JsonConvert.ToString(inner.Message) &amp; &quot;}&quot;&#xA;        End Try&#xA;        If httpStatus &lt;&gt; 0 AndAlso httpStatus &lt; 500 Then&#xA;            Exit For&#xA;        End If&#xA;        System.Threading.Thread.Sleep(attempt * 3000)&#xA;    Next&#xA;End Using&#xA;" DisplayName="5d. Update website - POST /api/rpa/import-bundle" sap2010:WorkflowViewState.IdRef="InvokeCode_23">
